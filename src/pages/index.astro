---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Supabase credentials are provisioned by Stripe Projects and written to `.env`.
// These are read at build time (server context) and the *public* anon key is
// embedded for the client — it is safe to expose and is protected by Row Level
// Security on the `messages` table (see supabase/schema.sql).
const supabaseUrl = import.meta.env.SUPABASE_PROJECT_URL ?? '';
const supabaseAnonKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY ?? '';
const contactEnabled = Boolean(supabaseUrl && supabaseAnonKey);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Hi, I'm {SITE_TITLE} 👋</h1>
				<p class="tagline">
					I design and build things for the web. This is my corner of the internet —
					take a look at my <a href="/portfolio">work</a> or read the
					<a href="/blog">blog</a>.
				</p>
				<div class="cta">
					<a class="button" href="/portfolio">View portfolio</a>
					<a class="button button-secondary" href="/blog">Read the blog</a>
				</div>
			</section>

			<section class="about">
				<h2>About</h2>
				<p>
					Replace this with a short introduction about yourself — what you do, what
					you're interested in, and what you're working on right now. Edit this page
					in <code>src/pages/index.astro</code>.
				</p>
			</section>

			<section class="contact">
				<h2>Get in touch</h2>
				{
					contactEnabled ? (
						<form
							id="contact-form"
							data-supabase-url={supabaseUrl}
							data-supabase-key={supabaseAnonKey}
						>
							<label>
								Name
								<input type="text" name="name" required />
							</label>
							<label>
								Email
								<input type="email" name="email" required />
							</label>
							<label>
								Message
								<textarea name="message" rows="4" required />
							</label>
							<button type="submit">Send message</button>
							<p id="contact-status" role="status" aria-live="polite" />
						</form>
					) : (
						<p class="notice">
							The contact form is disabled because Supabase isn't configured yet.
							Provision it with <code>stripe projects add supabase/project</code> and
							set <code>SUPABASE_PROJECT_URL</code> / <code>SUPABASE_PUBLISHABLE_KEY</code> in your
							<code>.env</code>.
						</p>
					)
				}
			</section>
		</main>
		<Footer />

		<script>
			import { createClient } from '@supabase/supabase-js';

			const form = document.getElementById('contact-form') as HTMLFormElement | null;
			if (form) {
				const url = form.dataset.supabaseUrl!;
				const key = form.dataset.supabaseKey!;
				const supabase = createClient(url, key);
				const status = document.getElementById('contact-status');

				form.addEventListener('submit', async (event) => {
					event.preventDefault();
					const data = new FormData(form);
					if (status) status.textContent = 'Sending…';

					const { error } = await supabase.from('messages').insert({
						name: String(data.get('name') ?? ''),
						email: String(data.get('email') ?? ''),
						message: String(data.get('message') ?? ''),
					});

					if (status) {
						status.textContent = error
							? `Something went wrong: ${error.message}`
							: 'Thanks! Your message has been sent.';
					}
					if (!error) form.reset();
				});
			}
		</script>

		<style>
			.hero {
				padding: 1rem 0 2rem;
			}
			.tagline {
				font-size: 1.25rem;
				color: rgb(var(--gray-dark));
			}
			.cta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}
			.button {
				display: inline-block;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				background: var(--accent);
				color: #fff;
				text-decoration: none;
				font-weight: 700;
			}
			.button:hover {
				background: var(--accent-dark);
				color: #fff;
			}
			.button-secondary {
				background: transparent;
				color: var(--accent);
				border: 2px solid var(--accent);
				padding: calc(0.6em - 2px) calc(1.2em - 2px);
			}
			section {
				margin-bottom: 2.5rem;
			}
			#contact-form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				max-width: 480px;
			}
			#contact-form label {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				font-weight: 700;
			}
			#contact-form input,
			#contact-form textarea {
				padding: 0.6em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				font-family: inherit;
			}
			#contact-form button {
				align-self: flex-start;
				padding: 0.6em 1.2em;
				border: none;
				border-radius: 8px;
				background: var(--accent);
				color: #fff;
				font-weight: 700;
				cursor: pointer;
			}
			#contact-form button:hover {
				background: var(--accent-dark);
			}
			#contact-status {
				margin: 0;
				font-weight: 400;
			}
			.notice {
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
		</style>
	</body>
</html>
