---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

// Edit this list to showcase your own work.
const projects = [
	{
		title: 'Project One',
		description:
			'A short description of what this project is and the problem it solves. Swap in your own work.',
		tags: ['Astro', 'TypeScript'],
		url: 'https://example.com',
	},
	{
		title: 'Project Two',
		description:
			'Another project worth highlighting. Mention your role and the impact it had.',
		tags: ['Design', 'Frontend'],
		url: 'https://example.com',
	},
	{
		title: 'Project Three',
		description:
			'One more example. Link out to a live demo, a case study, or the source code.',
		tags: ['Open source'],
		url: 'https://example.com',
	},
];

const title = `Portfolio · ${SITE_TITLE}`;
const description = 'A selection of projects and work.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Portfolio</h1>
			<p>A selection of things I've built. Edit these in <code>src/pages/portfolio.astro</code>.</p>
			<ul class="projects">
				{
					projects.map((project) => (
						<li class="card">
							<h2>{project.title}</h2>
							<p>{project.description}</p>
							<ul class="tags">
								{project.tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
							<a href={project.url} target="_blank" rel="noopener noreferrer">
								View project →
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
		<style>
			.projects {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 1.5rem;
				list-style: none;
				padding: 0;
				margin: 2rem 0 0;
			}
			.card {
				display: flex;
				flex-direction: column;
				padding: 1.5rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				background: #fff;
				transition: box-shadow 0.2s ease;
			}
			.card:hover {
				box-shadow: var(--box-shadow);
			}
			.card h2 {
				font-size: 1.4rem;
				margin-bottom: 0.5rem;
			}
			.card p {
				color: rgb(var(--gray-dark));
				flex: 1;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				list-style: none;
				padding: 0;
				margin: 0 0 1rem;
			}
			.tags li {
				font-size: 0.8rem;
				padding: 0.15em 0.6em;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.card a {
				font-weight: 700;
				text-decoration: none;
			}
		</style>
	</body>
</html>
