---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Algolia credentials are provisioned by Stripe Projects and written to `.env`.
// Only the search-only key is exposed to the client (the write key stays in the
// indexing script). Search degrades gracefully to the static list when unset.
const algoliaAppId = import.meta.env.ALGOLIA_APPLICATION_ID ?? '';
const algoliaSearchKey = import.meta.env.ALGOLIA_SEARCH_API_KEY ?? '';
const algoliaIndex = import.meta.env.ALGOLIA_APPLICATION_NAME ?? 'blog';
const searchEnabled = Boolean(algoliaAppId && algoliaSearchKey);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{
				searchEnabled && (
					<section
						id="blog-search"
						data-app-id={algoliaAppId}
						data-search-key={algoliaSearchKey}
						data-index={algoliaIndex}
					>
						<input
							id="blog-search-input"
							type="search"
							placeholder="Search posts…"
							aria-label="Search posts"
							autocomplete="off"
						/>
						<ul id="blog-search-results" hidden />
					</section>
				)
			}
			<section id="blog-list">
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />

		{
			searchEnabled && (
				<script>
					import { liteClient } from 'algoliasearch/lite';

					const root = document.getElementById('blog-search');
					const input = document.getElementById('blog-search-input') as HTMLInputElement | null;
					const results = document.getElementById('blog-search-results');
					const list = document.getElementById('blog-list');

					if (root && input && results && list) {
						const client = liteClient(root.dataset.appId!, root.dataset.searchKey!);
						const indexName = root.dataset.index!;

						const render = (hits: Array<Record<string, any>>) => {
							results.innerHTML = hits
								.map(
									(hit) =>
										`<li><a href="${hit.url}"><h4 class="title">${hit.title}</h4>` +
										`<p class="date">${hit.description ?? ''}</p></a></li>`,
								)
								.join('');
						};

						let timer: ReturnType<typeof setTimeout>;
						input.addEventListener('input', () => {
							clearTimeout(timer);
							const query = input.value.trim();
							timer = setTimeout(async () => {
								if (!query) {
									results.hidden = true;
									list.hidden = false;
									return;
								}
								const { results: res } = await client.search([
									{ indexName, params: { query, hitsPerPage: 8 } },
								]);
								render((res[0] as any).hits ?? []);
								results.hidden = false;
								list.hidden = true;
							}, 200);
						});
					}
				</script>
			)
		}

		<style>
			#blog-search {
				width: 960px;
				max-width: 100%;
				margin: 0 auto 2rem;
			}
			#blog-search-input {
				width: 100%;
				padding: 0.7em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				font-family: inherit;
			}
			#blog-search-results {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				list-style: none;
				margin: 1.5rem 0 0;
				padding: 0;
			}
			#blog-search-results a {
				text-decoration: none;
			}
			#blog-search-results .title {
				margin: 0;
				color: rgb(var(--black));
			}
			#blog-search-results .date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
		</style>
	</body>
</html>
