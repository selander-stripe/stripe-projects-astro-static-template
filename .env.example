# ---------------------------------------------------------------------------
# Environment variables
#
# When this template is built through Stripe Projects, these values are
# provisioned for you and written to a local `.env` file by:
#
#   stripe projects add posthog/analytics
#   stripe projects add algolia/application
#   stripe projects add netlify/project
#   stripe projects add supabase/project
#
# To run the project manually, copy this file to `.env` and fill in the values.
#
# NOTE: variable names follow each provider's standard convention. If the names
# Stripe Projects writes differ slightly, reconcile them here (and in the code
# that reads them) so they match what is in your `.env`.
# ---------------------------------------------------------------------------

# PostHog — product analytics & session replay (read in src/components/BaseHead.astro)
# The project API key is public/write-only and safe to expose in the browser.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Algolia — blog search
# SEARCH key is exposed to the browser (search-only). ADMIN key is used ONLY by
# the indexing script (npm run index) and must never reach the client.
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_INDEX_NAME=blog

# Supabase — contact form backend
# URL + ANON key are exposed to the browser (protected by RLS, see supabase/schema.sql).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Netlify — hosting/deploy (used by npm run deploy)
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
